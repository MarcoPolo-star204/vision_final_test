<launch>
  <arg name="use_sim_time" default="true"/>
  <arg name="rviz" default="true"/>
  <param name="/use_sim_time" value="$(arg use_sim_time)"/>
  <rosparam command="load" file="$(find ft_bringup)/config/detector.yaml"/>
  <rosparam command="load" file="$(find ft_bringup)/config/tracker.yaml"/>

  <node pkg="ft_detector" type="ft_detector_node" name="ft_detector" output="screen"/>
  <node pkg="ft_tracker" type="ft_tracker_node" name="ft_tracker" output="screen"/>
  <node pkg="ft_selector" type="ft_selector_node" name="ft_selector" output="screen"/>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find ft_bringup)/rviz/vision_final.rviz"/>
</launch>

Panels:
  - Class: rviz/Displays
    Help Height: 138
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
    Tree Height: 1206
Preferences:
  PromptSaveOnExit: true
Toolbars:
  toolButtonStyle: 2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.029999999329447746
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Filter (blacklist): ""
      Filter (whitelist): ""
      Frame Timeout: 15
      Frames:
        All Enabled: true
        armor_0:
          Value: true
        armor_1:
          Value: true
        armor_2:
          Value: true
        base_link:
          Value: true
        base_pitch:
          Value: true
        base_yaw:
          Value: true
        camera2_optical_frame:
          Value: true
        camera_link:
          Value: true
        camera_optical_frame:
          Value: true
        gimbal_imu:
          Value: true
        hk_camera_ca:
          Value: true
        left_back_wheel:
          Value: true
        left_friction_wheel:
          Value: true
        left_front_wheel:
          Value: true
        odom:
          Value: true
        pitch:
          Value: true
        right_back_wheel:
          Value: true
        right_friction_wheel:
          Value: true
        right_front_wheel:
          Value: true
        trigger:
          Value: true
        yaw:
          Value: true
      Marker Alpha: 1
      Marker Scale: 1
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree:
        armor_0:
          {}
        armor_1:
          {}
        armor_2:
          {}
        hk_camera_ca:
          {}
        odom:
          base_link:
            base_yaw:
              trigger:
                {}
              yaw:
                base_pitch:
                  pitch:
                    camera2_optical_frame:
                      {}
                    camera_link:
                      {}
                    camera_optical_frame:
                      {}
                    gimbal_imu:
                      {}
                    left_friction_wheel:
                      {}
                    right_friction_wheel:
                      {}
            left_back_wheel:
              {}
            left_front_wheel:
              {}
            right_back_wheel:
              {}
            right_front_wheel:
              {}
      Update Interval: 0
      Value: true
    - Class: rviz/Marker
      Enabled: true
      Marker Topic: /ft/debug/marker
      Name: TrackMarker
      Namespaces:
        {}
      Queue Size: 100
      Value: true
    - Class: rviz/Image
      Enabled: false
      Image Topic: /ft/debug/image
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: DebugImage
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: false
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Default Light: true
    Fixed Frame: camera
    Frame Rate: 30
  Name: root
  Tools: ~
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Field of View: 0.7853981852531433
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 0.4000000059604645
      Target Frame: <Fixed Frame>
      Yaw: 0.800000011920929
    Saved: ~
Window Geometry:
  DebugImage:
    collapsed: false
  Displays:
    collapsed: false
  Height: 1590
  Hide Left Dock: false
  Hide Right Dock: false
  QMainWindow State: 
  Width: 2938
  X: 64
  Y: 342
